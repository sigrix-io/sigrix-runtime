# Provider keys required by this Sigrix listing bundle.
# Copy this file to .env and fill in your own values.

# OpenAI API key — used by the agent to call the configured model.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: model override. Defaults to the model declared in the listing.
# OPENAI_MODEL_NAME=gpt-4o-mini

# Optional: Serper API key, only required if any agent uses serper_search.
# Get one at https://serper.dev
# SERPER_API_KEY=
